---
// A link styled as a button with the shared button's classes (CSS only; the site runs no scripts).
import { buttonVariants } from '@spotcraft/ui/components/button'

interface Props {
  href: string
  variant?: 'default' | 'outline'
  rel?: string
}
const { href, variant = 'default', rel } = Astro.props
---

<!-- biome-ignore lint/a11y/useAnchorContent: the slot is the link's text -->
<a href={href} rel={rel} class={buttonVariants({ variant, size: 'lg' })}><slot /></a>
