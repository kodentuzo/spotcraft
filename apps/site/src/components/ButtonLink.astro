---
// A link styled as a button with spotstrap's `btn` classes (CSS only; the site runs no scripts).
interface Props {
  href: string
  variant?: 'default' | 'outline'
  rel?: string
}
const { href, variant = 'default', rel } = Astro.props
---

<!-- biome-ignore lint/a11y/useAnchorContent: the slot is the link's text -->
<a href={href} rel={rel} class:list={['btn', { 'btn-outline': variant === 'outline' }]}><slot /></a>
