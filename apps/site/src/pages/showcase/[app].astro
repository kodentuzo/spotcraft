---
import { getCollection, render } from 'astro:content'
import { Button } from '@spotcraft/ui/components/button'
import * as Card from '@spotcraft/ui/components/card'
import GitHubIcon from '../../components/GitHubIcon.astro'
import Screenshot from '../../components/Screenshot.astro'
import Base from '../../layouts/Base.astro'

export async function getStaticPaths() {
  const apps = await getCollection('showcase')
  return apps.map((app) => ({ params: { app: app.id }, props: { app } }))
}

const { app } = Astro.props
const { data } = app
const { Content } = await render(app)
const [hero, ...more] = data.screenshots
const { numbers } = data

const pending = 'to come'
const figures = [
  {
    label: 'Memory',
    value: numbers.memory ?? pending,
    note: numbers.memoryLimit ? `of a ${numbers.memoryLimit} limit` : undefined,
  },
  { label: 'Uptime', value: numbers.uptime ?? pending, note: 'over 30 days' },
  { label: 'Deploy', value: numbers.deployTime ?? pending, note: 'from the deploy hook to live' },
  { label: 'Image', value: numbers.imageSize ?? pending, note: 'compressed, amd64' },
]
const dated = numbers.date?.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
})
---

<Base title={`${data.name} · Showcase · Spotcraft`} description={`${data.name}: ${data.oneLiner}`}>
  <article class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <!-- Hero -->
    <p class="font-mono text-sm text-muted-foreground">
      <a href="/showcase" class="hover:text-foreground">Showcase</a> / {data.name}
    </p>
    <h1 class="mt-3 font-heading text-4xl font-bold tracking-tight sm:text-5xl">{data.name}</h1>
    <p class="mt-4 max-w-2xl text-lg text-pretty text-muted-foreground">{data.oneLiner}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={data.url} size="lg" rel="noopener noreferrer">Visit {new URL(data.url).host}</Button>
      <Button href={data.source} size="lg" variant="outline" rel="noopener noreferrer"><GitHubIcon data-icon="inline-start" /> Source</Button>
    </div>
    <Screenshot {...hero} class="mt-12 shadow-sm" eager />

    <!-- What it is -->
    <section class="mt-20 grid gap-6 border-t pt-12 sm:grid-cols-[1fr_2fr]">
      <h2 class="font-heading text-2xl font-bold">What it is</h2>
      <p class="text-lg text-muted-foreground">{data.about}</p>
    </section>

    <!-- What Spotcraft does for it -->
    <section class="mt-16 grid gap-6 border-t pt-12 sm:grid-cols-[1fr_2fr]">
      <h2 class="font-heading text-2xl font-bold">What Spotcraft does for it</h2>
      <ul class="grid gap-3">
        {
          data.features.map((feature) => (
            <li>
              <Card.Root size="sm">
                <Card.Content class="flex flex-row gap-4">
                  <svg class="mt-0.5 size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <div>
                    <h3 class="font-heading font-semibold">{feature.name}</h3>
                    <p class="mt-1 text-sm leading-6 text-muted-foreground">{feature.text}</p>
                  </div>
                </Card.Content>
              </Card.Root>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- By the numbers -->
    <section class="mt-16 border-t pt-12">
      <h2 class="font-heading text-2xl font-bold">By the numbers</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        {dated ? `From the Spotcraft dashboard on ${dated}.` : 'From the Spotcraft dashboard.'}
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          figures.map((figure) => (
            <Card.Root>
              <Card.Content>
                <dl>
                  <dt class="text-sm text-muted-foreground">{figure.label}</dt>
                  <dd class="mt-2 font-heading text-3xl font-bold tabular-nums">{figure.value}</dd>
                  {figure.note && <dd class="mt-1 text-sm text-muted-foreground">{figure.note}</dd>}
                </dl>
              </Card.Content>
            </Card.Root>
          ))
        }
      </div>
    </section>

    <!-- The story -->
    <section class="mt-16 grid gap-6 border-t pt-12 sm:grid-cols-[1fr_2fr]">
      <h2 class="font-heading text-2xl font-bold">The story</h2>
      <div class="doc max-w-prose">
        <Content />
      </div>
    </section>

    <!-- Stack -->
    <section class="mt-16 grid gap-6 border-t pt-12 sm:grid-cols-[1fr_2fr]">
      <h2 class="font-heading text-2xl font-bold">Stack</h2>
      <ul class="grid gap-x-10 gap-y-5 sm:grid-cols-2">
        {
          data.stack.map((item) => (
            <li>
              <p class="font-heading font-semibold">{item.name}</p>
              <p class="mt-1 text-sm text-muted-foreground">{item.role}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- More screenshots -->
    {
      more.length > 0 && (
        <section class="mt-16 border-t pt-12">
          <h2 class="font-heading text-2xl font-bold">More screenshots</h2>
          <ul class="mt-8 grid gap-6 md:grid-cols-2">
            {more.map((shot) => (
              <li>
                <Screenshot {...shot} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="mt-16 border-t pt-8">
      <a href="/showcase" class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
        >← All apps on Spotcraft</a
      >
    </p>
  </article>
</Base>
