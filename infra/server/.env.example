# Copied to /opt/spotcraft/.env on the server; the deploy script writes it.
DASHBOARD_DOMAIN=dash.example.com
SPOTCRAFT_TAG=latest
SPOTCRAFT_IMAGE=vindotski/spotcraft
# openssl rand -hex 32; shared by the dashboard and the agent.
AGENT_TOKEN=change-me-to-64-hex-characters-0000000000000000000000000000000
# pnpm --filter @spotcraft/dashboard hash-password
DASHBOARD_PASSWORD_HASH=scrypt:0000:0000
# openssl rand -hex 32
SESSION_SECRET=change-me-to-64-hex-characters-0000000000000000000000000000000
# getent group docker | cut -d: -f3
DOCKER_GID=999
# openssl rand -hex 32; the agent's Postgres role (spotcraft_agent).
POSTGRES_AGENT_PASSWORD=change-me-to-64-hex-characters-000000000000000000000000000000
# Generated by the deploy script on the first deploy and kept; only used when Postgres
# creates its data directory.
POSTGRES_SUPERUSER_PASSWORD=change-me-to-64-hex-characters-000000000000000000000000000000
# Generated by the deploy script on the first deploy and kept: the user pool's Postgres role
# (spotcraft_auth) and its secret, which signs every session (ADR 0035).
POSTGRES_AUTH_PASSWORD=change-me-to-64-hex-characters-000000000000000000000000000000
AUTH_SECRET=change-me-to-64-hex-characters-0000000000000000000000000000000000000
# Optional: origins (comma-separated) that may call the user pool from other sites.
AUTH_TRUSTED_ORIGINS=
# Optional: how long the user pool keeps idle guests, sessions' IP addresses and user agents,
# and deleted users' ids. AUTH_BACKUP_DAYS must match backup_retention_days in infra/cloudflare.
# The agent reads them too, for the legal facts apps show (ADR 0043).
AUTH_GUEST_DAYS=180
AUTH_IP_DAYS=30
AUTH_BACKUP_DAYS=30
POSTGRES_UMAMI_PASSWORD=change-me-to-64-hex-characters-000000000000000000000000000000
UMAMI_SECRET=change-me-to-64-hex-characters-00000000000000000000000000000000000
UMAMI_ADMIN_PASSWORD=change-me-to-64-hex-characters-000000000000000000000000000000000
# Optional: every app is also served at <name>.<APPS_DOMAIN>. Point a wildcard record
# (*.apps.example.com) at this server. Leave empty to give each app its own domain only.
APPS_DOMAIN=
EDGE=direct
# Optional, with EDGE=cloudflare: the agent sets up custom domains' DNS (infra/cloudflare outputs).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_APPS_ZONE_ID=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_ACCESS_POLICY_ID=
# Optional, both or neither: with Cloudflare Access in front, its sign-in skips the password.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Behind a Cloudflare Tunnel (EDGE=cloudflare, ADR 0021) the deploy adds:
# COMPOSE_PROFILES=cloudflare
# CLOUDFLARE_TUNNEL_TOKEN=...          # the server's tunnel (infra/cloudflare outputs)
# PUBLIC_BIND=127.0.0.1
# CADDY_TRUSTED_PROXIES=10.255.254.2/32   # cloudflared's fixed address
# DASHBOARD_PEERS=10.255.254.2/32
# DASHBOARD_SCHEME=http://
